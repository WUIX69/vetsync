# Application Settings
APP_NAME="Vetsync"
APP_ENV=dev
APP_DEBUG=true
APP_URL=http://localhost

# Database Configuration (XAMPP MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vetsync
DB_USERNAME=root
DB_PASSWORD=

# PHP Settings
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=10M
PHP_POST_MAX_SIZE=10M
PHP_ERROR_REPORTING=E_ALL
PHP_DISPLAY_ERRORS=true
PHP_LOG_ERRORS=true
PHP_ERROR_LOG="error.log"

# SMTP Configuration (if needed)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS=null
# MAIL_FROM_NAME="${APP_NAME}"

# AJAX Settings
AJAX_TIMEOUT=30000
AJAX_CACHE=false
AJAX_RETRY_ATTEMPTS=3
AJAX_RETRY_DELAY=1000

# Session Settings
SESSION_LIFETIME=120
SESSION_NAME=VETSYNC_SESSION

# Custom App Settings
TIMEZONE=Asia/Manila
DATE_FORMAT="Y-m-d"
TIME_FORMAT="H:i:s"
CURRENCY=PHP

# Development Tools
ERROR_LOG_PATH=logs/error.log
ACCESS_LOG_PATH=logs/access.log
